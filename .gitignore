# Datasets (large, and mostly not redistributable)
data/raw/
data/raw_demo/
data/manifest.csv
data/demo/
backend/data/

# Trained artefacts. The pretrained ImageNet inference files are kept so a fresh
# clone can deploy to Render immediately; checkpoints and training runs stay local.
artifacts_demo/*
!artifacts_demo/waste_model_int8.onnx
!artifacts_demo/labels.json
artifacts_pretrained/*
!artifacts_pretrained/mobilenet_v3_large_imagenet.onnx
!artifacts_pretrained/mobilenet_v3_large_int8.onnx
!artifacts_pretrained/labels.json
!artifacts_pretrained/mapping_report.md
# Open-vocabulary CLIP head: only the three runtime files are kept in git.
artifacts_clip/*
!artifacts_clip/mobileclip2_s0_visual_fp16.onnx
!artifacts_clip/clip_text_embeds.npz
!artifacts_clip/clip_meta.json
artifacts/
/*.onnx
*.pt
*.tflite
runs/

