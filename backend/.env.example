# Copy to .env and fill in what you have. Everything works with no keys at all:
#   LLM_PROVIDER=fake        -> template answers built from label_map.yaml
#   FACILITY_PROVIDER=fixture -> sample facilities shipped in backend/fixtures

# ---- model ----
# Paths are relative to the project root unless absolute.
ONNX_PATH=artifacts/waste_model_int8.onnx
LABELS_PATH=artifacts/labels.json
CLASSIFIER_ENABLED=true

# ---- database ----
DB_PATH=backend/data/app.db

# ---- LLM ----
# fake | groq | gemini
LLM_PROVIDER=fake
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20

# ---- facilities ----
# fixture | overpass
FACILITY_PROVIDER=fixture
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
FACILITY_CACHE_DAYS=30

# ---- app ----
ALLOW_ORIGINS=*
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=8

# ---- optional image storage (Cloudinary) ----
# Off by default: uploads stay in memory and only the label is stored.
# Enable BOTH lines to keep a sanitized copy of each scan photo in Cloudinary.
IMAGE_STORAGE=false
# Dashboard -> Programmable Media -> API environment variable (keep this secret)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kachra-mitra/scans
CLOUDINARY_TIMEOUT_S=15
