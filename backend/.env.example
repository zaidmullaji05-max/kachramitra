# Copy to .env and fill in what you have. Everything works with no keys at all:
#   LLM_PROVIDER=fake        -> template answers built from label_map.yaml
#   FACILITY_PROVIDER=fixture -> sample facilities shipped in backend/fixtures

# ---- model ----
# Paths are relative to the project root unless absolute.
# Pretrained ImageNet MobileNetV3-Large mapped to the 32 waste items.
ONNX_PATH=artifacts_pretrained/mobilenet_v3_large_imagenet.onnx
LABELS_PATH=artifacts_pretrained/labels.json
CLASSIFIER_ENABLED=true
# Set true only to keep the synthetic artifacts_demo model for a pipeline demo.
ALLOW_DEMO_MODEL=false

# ---- zero-shot CLIP head (optional second opinion, on by default) ----
# Covers the items ImageNet has no class for: battery, charger, bulb, PCB, syringe.
CLIP_ENABLED=true
CLIP_MODEL_PATH=artifacts_clip/mobileclip2_s0_visual_fp16.onnx
CLIP_EMBEDS_PATH=artifacts_clip/clip_text_embeds.npz

# ---- database ----
# Local file used only when DATABASE_URL is empty.
DB_PATH=backend/data/app.db
# Neon PostgreSQL. Dashboard → Connect → "Connection string" (pooled is fine).
# Example:
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Leave empty to keep using SQLite. Accounts, scans and the admin panel use this URL.
DATABASE_URL=
# Signs login tokens. Use a long random string on any shared server.
AUTH_SECRET=

# ---- LLM ----
# fake | groq | gemini
LLM_PROVIDER=fake
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20

# ---- facilities ----
# auto = live OpenStreetMap near the user, then sample data only if that fails
# fixture = bundled Mumbai sample points (offline demo)
# overpass = live OpenStreetMap only
FACILITY_PROVIDER=auto
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
FACILITY_CACHE_DAYS=30

# ---- app ----
ALLOW_ORIGINS=*
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=8

# ---- admin panel ----
# Passphrase login (leave email blank on the admin page) AND the password of the
# seeded admin account. Leave ADMIN_PASSWORD empty to keep the panel off.
ADMIN_PASSWORD=
# When both are set, this email becomes an admin user in Neon (or SQLite).
# Sign in with it from the app's Log in button or from the admin page.
ADMIN_EMAIL=
ADMIN_TOKEN_TTL_HOURS=12

# ---- optional image storage (Cloudinary) ----
# Off by default: uploads stay in memory and only the label is stored.
# Enable BOTH lines to keep a sanitized copy of each scan photo in Cloudinary.
IMAGE_STORAGE=false
# Dashboard -> Programmable Media -> API environment variable (keep this secret)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kachra-mitra/scans
CLOUDINARY_TIMEOUT_S=15
